---
import type { CollectionEntry } from "astro:content";
import { getSlug } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
	<section class="card-base rounded-[var(--radius-large)] px-6 md:px-9 py-5 mb-6">
		<div class="text-sm text-black/45 dark:text-white/45 mb-3">相关文章</div>
		<div class="grid md:grid-cols-3 gap-3">
			{posts.map((post) => (
				<a
					href={getPostUrlBySlug(getSlug(post))}
					class="rounded-xl px-3 py-3 transition bg-black/[0.03] hover:bg-[var(--btn-plain-bg-hover)] dark:bg-white/[0.05] dark:hover:bg-white/10"
				>
					<div class="font-semibold text-sm text-black/80 dark:text-white/80 mb-1">{post.data.title}</div>
					<div class="text-xs text-black/45 dark:text-white/45">{post.data.category || "文章"}</div>
				</a>
			))}
		</div>
	</section>
)}
