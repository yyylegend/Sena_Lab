---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center overflow-visible transition" onclick="backToTop()">
        <div class="relative h-[3.25rem] w-[3.25rem]">
            <svg class="progress-ring absolute inset-0 -rotate-90" width="52" height="52" viewBox="0 0 52 52">
                <circle
                    class="progress-ring-circle"
                    cx="26" cy="26" r="22"
                    fill="none"
                    stroke="var(--primary)"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-dasharray="138.2"
                    stroke-dashoffset="138.2"
                />
            </svg>
            <button aria-label="Back to Top" class="btn-card h-[3.25rem] w-[3.25rem] !rounded-full">
                <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
            </button>
        </div>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.25rem
    height: 3.25rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    bottom: 10rem
    opacity: 1
    cursor: pointer
    transform: translateX(5rem)
    pointer-events: auto
    i
        font-size: 1.75rem
    &.hide
        transform: translateX(5rem) scale(0.9)
        opacity: 0
        pointer-events: none
    &:active
      transform: translateX(5rem) scale(0.9)

.progress-ring-circle
    transition: stroke-dashoffset 0.1s linear

</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}

function initReadingProgress() {
    const circle = document.querySelector('.progress-ring-circle');
    if (!circle) return;

    const isPostPage = !!document.getElementById('post-container');
    if (!isPostPage) {
        circle.style.opacity = '0';
        return;
    }
    circle.style.opacity = '1';

    const circumference = 138.2;

    function updateProgress() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? scrollTop / docHeight : 0;
        const offset = circumference * (1 - progress);
        circle.style.strokeDashoffset = offset;
    }

    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });
}

initReadingProgress();
document.addEventListener('swup:page:view', initReadingProgress);
</script>
